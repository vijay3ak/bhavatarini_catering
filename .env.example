# ==========================================
# Bhavatarini Catering Service — Environment Variables
# ==========================================

# Public Contact Configuration (Keep empty until official details are provided)
# DO NOT add fake phone numbers or addresses.
NEXT_PUBLIC_WHATSAPP_NUMBER=""           # e.g., "919876543210" (digits only, including country code)
NEXT_PUBLIC_CONTACT_PHONE=""             # e.g., "+91 98765 43210" (formatted for customer view)
NEXT_PUBLIC_CONTACT_EMAIL=""             # e.g., "contact@bhavatarinicatering.com"
NEXT_PUBLIC_BUSINESS_LOCATION="Coimbatore, Tamil Nadu"
NEXT_PUBLIC_SERVICE_AREA=""              # Optional (leave empty until confirmed, e.g. "Coimbatore and nearby locations")
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Supabase PostgreSQL & Auth Configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key" # Server-only! Never expose in client code.

# Resend Transactional Email Configuration
RESEND_API_KEY="re_your_resend_api_key"                    # Server-only!
OPERATOR_NOTIFICATION_EMAIL=""                             # Internal catering manager email to receive lead alerts
